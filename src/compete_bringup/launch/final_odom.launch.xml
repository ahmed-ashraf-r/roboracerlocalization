<launch>

    <!-- 1. Simulator / Graphics -->
    <include file="$(find-pkg-share autodrive_roboracer)/launch/bringup_graphics.launch.py">
    </include>


    <!-- 2. map -> world static bridge -->
    <node
        pkg="tf2_ros"
        exec="static_transform_publisher"
        name="map_world_tf"
        args="0 0 0 0 0 0 map world"
        output="screen">
    </node>


    <!-- 3. Ackermann odometry -->
    <timer period="1.0">
        <node
            pkg="compete_localiztion"
            exec="ackermann_odom.py"
            name="ackermann_odom"
            output="screen">
        </node>
    </timer>


    <!-- 4. EKF -->
    <timer period="2.0">
        <include
            file="$(find-pkg-share compete_localiztion)/launch/local_localization.launch.xml">
        </include>
    </timer>


    <!-- 5. Particle Filter -->
    <timer period="3.0">
        <include
            file="$(find-pkg-share particle_filter)/launch/localize_launch.py">
        </include>
    </timer>


    <!-- 6. Global high-rate odometry -->
    <timer period="4.5">
        <node
            pkg="compete_localiztion"
            exec="global_odom_fuser.py"
            name="global_odom_fuser"
            output="screen">
        </node>
    </timer>

</launch>