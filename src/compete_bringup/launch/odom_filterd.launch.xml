<launch>

    <!-- ========================================================= -->
    <!-- 1. Robot / Graphics Bringup                               -->
    <!-- ========================================================= -->

    <include file="$(find-pkg-share autodrive_roboracer)/launch/bringup_graphics.launch.py">
    </include>


    <!-- ========================================================= -->
    <!-- 2. Ackermann Odometry                                     -->
    <!-- ========================================================= -->

    <node
        pkg="compete_localiztion"
        exec="ackermann_odom.py"
        name="ackermann_odom"
        output="screen">
    </node>


    <!-- ========================================================= -->
    <!-- 3. RF2O Laser Odometry                                    -->
    <!-- ========================================================= -->

    <include file="$(find-pkg-share rf2o_laser_odometry)/launch/compete_laser_odom.launch.py">
    </include>


    <!-- ========================================================= -->
    <!-- 4. Localization                                           -->
    <!-- ========================================================= -->

    <include file="$(find-pkg-share compete_localiztion)/launch/local_localization.launch.xml">
    </include>

</launch>